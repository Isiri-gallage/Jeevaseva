# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# Create React App only exposes variables prefixed with REACT_APP_, and they are
# baked in at BUILD time — a production build needs this set before `npm run build`.

# Base URL of the RaktaSeva API, including the /api/v1 prefix.
# The chat WebSocket URL is derived from this automatically.
REACT_APP_API_URL=http://localhost:8000/api/v1
